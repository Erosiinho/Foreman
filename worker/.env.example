REDIS_URL=redis://localhost:6379

# Octokit PAT used to update issue labels/comments (repo scope)
GITHUB_TOKEN=

# gh CLI auth (repo + workflow scopes) — see PLAN.md §7
GH_TOKEN=

# No ANTHROPIC_API_KEY here: Claude Code auth uses the Pro/Max subscription via `claude login`
# (interactive, browser-based), run once on whatever machine/container actually executes `claude`.
# In Docker, that session is persisted on the claude_config volume — see PLAN.md §7/§8.

# Root folder containing the projects Foreman can run tasks against, one subfolder per repo
# (shared volume with code-server in production — see PLAN.md §8)
PROJECTS_ROOT=/projects

GIT_AUTHOR_NAME=Foreman Bot
GIT_AUTHOR_EMAIL=foreman@ealb.fr

# How many different repos the worker can run tasks for in parallel. A given repo is still capped at
# one active-or-paused task regardless of this value (RepoLock, PLAN.md §9 "per-project lock").
WORKER_CONCURRENCY=4

# Kills a run and marks it `failed` if `claude` hasn't finished within this many minutes.
RUN_TIMEOUT_MINUTES=45

# Optional — end-of-task notification (done/failed) with the PR link. Leave both blank to disable.
# Create a bot via @BotFather, then message it once and check
# https://api.telegram.org/bot<token>/getUpdates for your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
